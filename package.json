  "homepage": "https://github.com/everpaula/marcas-de-ia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everpaula/marcas-de-ia.git"
  },
  "bugs": "https://github.com/everpaula/marcas-de-ia/issues"
}
