{
  "name": "marcas-de-ia",
  "version": "0.1.0",
  "description": "Acha as marcas que deixam um texto em português com cara de IA: travessão, \"não é X, é Y\", vocabulário de IA, caso inventado e mais.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "marcas-de-ia": "./cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js"
  ],
  "scripts": {
    "test": "node --test test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pt-br",
    "portugues",
    "ia",
    "texto",
    "revisao",
    "copywriting",
    "lint",
    "chatgpt",
    "claude"
  ],
  "author": "Everton Paula",
